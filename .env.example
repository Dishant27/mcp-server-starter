# Copy to .env for local experiments, or (recommended) set these in the "env"
# block of your MCP client config. Never commit real keys.

# API key for the upstream service used by the example-search tool
EXAMPLE_API_KEY=

# Optional: override the upstream API base URL
# EXAMPLE_API_BASE_URL=https://api.example.com

# Optional: debug | info | warn | error (default: info). Logs go to stderr.
# LOG_LEVEL=info
